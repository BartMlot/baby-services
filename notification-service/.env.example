APP_ENV=dev
APP_SECRET=change-me

DATABASE_URL="postgresql://notif_user:notif_pass@postgres-notification:5432/notification?serverVersion=15&charset=utf8"
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f

# Mailtrap (dev email)
MAILTRAP_DSN=mailtrap+api://API_TOKEN@default
MAILTRAP_FROM=noreply@your-verified-domain.com

# AWS SES (prod email) — IAM requires ses:SendEmail, ses:SendRawEmail
SES_DSN=ses+api://ACCESS_KEY:SECRET_KEY@default?region=eu-west-1
SES_FROM=noreply@your-verified-domain.com

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+12025551234
